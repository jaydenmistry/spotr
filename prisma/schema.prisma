// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  /// "admin" | "member" (src/lib/roles.ts). Only admins review access requests.
  role     String @default("member")
  /// Bumped whenever the password changes or the seed locks the account;
  /// sessions issued under an older value are rejected (src/lib/auth.ts).
  sessionVersion Int @default(0)
  assignedLeads  Lead[]
}

// Dealership acquisition criteria. Single-tenant v1: exactly one row with
// id "default"; the id column is the future per-dealer tenancy seam.
// makeRules / excludedKeywords hold JSON strings (SQLite has no Json type);
// parse/serialize lives in src/lib/buyBox.ts.
model BuyBox {
  id               String   @id
  yearMin          Int?
  yearMax          Int?
  maxMileage       Int?
  // Asking-price band the desk buys in (USD).
  acquisitionMin   Int?
  acquisitionMax   Int?
  // Sanity band for retail estimates (USD).
  targetRetailMin  Int?
  targetRetailMax  Int?
  // Gross-profit planning target (USD) — drives the recommended max offer.
  targetMinGross   Int      @default(3000)
  radiusMiles      Int      @default(100)
  makeRules        String   @default("[]")
  excludedKeywords String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  vin         String?
  year        Int?
  make        String?
  model       String?
  trim        String?
  listingTitle String?
  price       Int?
  miles       Int?
  distanceMiles Float?
  searchZip   String?
  searchRadius Int?
  city        String?
  state       String?
  source      String?
  vdp_url     String?
  photo_url   String?
  stage       String   @default("New Leads")
  sellerName  String?
  sellerPhone String?
  // Opportunity Feed actions — nullable so existing rows are unaffected.
  watchedAt   DateTime?
  passedAt    DateTime?
  // Who is working the lead; cleared if that user is deleted. Responses
  // flatten it to `assignedTo` (the email) via src/lib/leadAssignee.ts.
  assignedToId String?
  assignee     User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  // Follow-up workflow — all nullable, additive.
  nextAction            String?
  nextActionAt          DateTime?
  nextActionCompletedAt DateTime?
  // Standardized reason recorded when the lead is Passed or marked Lost;
  // cleared when restored from Passed. Codes live in src/lib/followUp.ts.
  outcomeReason String?
  outcomeNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    Message[]
  activities  Activity[]

  // Every list endpoint filters on VIN prefixes; index it before the table grows.
  @@index([vin])
  // Feed hot path: filters on stage/passedAt, orders by createdAt.
  @@index([stage, passedAt, createdAt])
  @@index([assignedToId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  role      String   // "user" or "seller"
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Buyer-action audit trail for a lead. Rows are written only inside the same
// Prisma transaction as the Lead mutation they describe; `detail` is a JSON
// string built server-side from a per-type allowlist (src/lib/followUp.ts) —
// never raw client JSON, never seller PII.
model Activity {
  id        String   @id @default(cuid())
  type      String   // ActivityType in src/lib/followUp.ts
  summary   String   // concise human-readable, buyer-attributed
  detail    String?
  // TODO: replace with a User relation (actorId) once RBAC/multi-tenancy
  // lands — email is not a stable cross-tenant key, and this append-only
  // table will be the largest backfill if it waits.
  actor     String?  // session email (single-tenant v1)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// VINs whose sellers asked to be removed. Lead pulls skip these so a deleted
// listing isn't imported again (scripts/delete-seller-data.mjs adds them;
// docs/seller-data-requests.md). Stored uppercase; nothing else about the
// seller is kept here.
model SuppressedVin {
  vin       String   @id
  createdAt DateTime @default(now())
}

// Inbound "Request access" submissions from the public site. Prospect
// (dealer staff) contact details only — never seller PII. Reviewed by the
// signed-in team at /dashboard/requests; status is new → contacted → archived.
model AccessRequest {
  id         String   @id @default(cuid())
  name       String
  email      String
  dealership String
  role       String
  message    String?
  status     String   @default("new")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
}
