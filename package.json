{
  "name": "spotr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:setup && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:inventory": "vitest run src/app/dashboard/inventory/page.test.tsx",
    "seed": "node prisma/seed.js",
    "db:setup": "node prisma/migrate.js && npm run seed",
    "seed:fixtures": "node scripts/seed-feed-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker run --rm --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "11.10.0",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.18.0",
    "motion": "14.9.0",
    "next": "16.4.4",
    "next-auth": "^4.24.15",
    "prisma": "^5.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint-config-next": "16.4.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
