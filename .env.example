# ---- Required ----

# Marketcheck listings API key
MARKETCHECK_API_KEY=

# SQLite connection string.
# Local dev: file:./dev.db (relative to prisma/schema.prisma)
# Docker/production: leave unset — the Dockerfile defaults to file:/app/data/prod.db
DATABASE_URL="file:./dev.db"

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the deployed app, e.g. https://spotrcars.com
NEXTAUTH_URL="http://localhost:3000"

# Admin login. The seed script (npm run seed / container startup) hashes the
# password with bcrypt and upserts this user. Min 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Optional ----

# Public site URL used for SEO metadata / sitemap (defaults to https://spotrcars.com)
# NEXT_PUBLIC_SITE_URL=https://spotrcars.com

# Privacy-friendly analytics (Umami/Plausible-compatible). Both must be set at
# BUILD time (Dokploy: Build-time Arguments) since NEXT_PUBLIC_ vars are inlined.
# NEXT_PUBLIC_ANALYTICS_SRC=https://analytics.example.com/script.js
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Optional: powers the AI practice chat (simulated seller). Without it the chat shows an error.
GEMINI_API_KEY=
